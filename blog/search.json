---
layout: null
---

[
{% assign documents = site.posts
    | concat: site.notes
    | concat: site.archive %}

{% for doc in documents %}
{
  "title": {{ doc.title | jsonify }},
  "description": {{ doc.description | default: doc.blurb | jsonify }},
  "url": {{ doc.url | relative_url | jsonify }},
  "collection": {{ doc.collection | jsonify }},
  "date": {{ doc.date | date: "%Y-%m-%d" | jsonify }},
  "tags": {{ doc.tags | jsonify }}
}{% unless forloop.last %},{% endunless %}
{% endfor %}
]